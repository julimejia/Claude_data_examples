  "format": "parquet",
  "baseline": [
    "id:BIGINT!",
    "email:VARCHAR"
  ],
  "current": [
    "id:BIGINT!",
    "quantity:VARCHAR"
  ],
  "expected": {
    "verdict": "breaking",
    "changes": [
      {
        "change_type": "column_removed",
