# SchemaSentinel — environment variables (template)
# Copy to .env (or keep them in your global ~/.env) and fill in real values.
# NEVER commit real values. This file must contain placeholders only.

# Anthropic API key. OPTIONAL: the default LLM adapter runs through the Claude Code CLI
# (`claude -p`) on the local machine and does not need a key. Only set this if you
# switch to an API-based adapter.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Telegram bot token, created with @BotFather (/newbot). Used to send architectural
# decisions and progress notices, and to read your replies.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Numeric id of the only chat the bot is allowed to talk to. Messages from any other
# chat are ignored. Get it by messaging your bot, then calling getUpdates.
TELEGRAM_CHAT_ID=your-numeric-chat-id-here
